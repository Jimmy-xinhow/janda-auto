---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/blog/' | absolute_url }}</loc>
    <lastmod>{% if site.posts.first %}{{ site.posts.first.updated_at | default: site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ '/blog/categories/' | absolute_url }}</loc>
    <lastmod>{% if site.posts.first %}{{ site.posts.first.updated_at | default: site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% for item in site.data.category_details %}<url>
    <loc>{{ '/blog/categories/' | append: item[0] | append: '/' | absolute_url }}</loc>
    <lastmod>{% assign category_posts = site.posts | where: 'category', item[0] %}{% if category_posts.first %}{{ category_posts.first.updated_at | default: category_posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>{% endfor %}
  {% for post in site.posts %}<url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.updated_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {% if post.cover_image %}<image:image><image:loc>{{ site.url }}{{ post.cover_image }}</image:loc><image:caption>{{ post.cover_alt | xml_escape }}</image:caption></image:image>{% endif %}
  </url>{% endfor %}
</urlset>
